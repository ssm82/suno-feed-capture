# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo

# Build artefacts
*.zip
*.crx
*.pem
# build/ is a mirror of the extension files at the repo root, used only
# as the input for `zip`. Loading the repo root directly into Chrome also
# works (8 files at root), so the mirror is redundant in git history.
build/

# Node (if you ever add a tooling layer)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local dev overrides
.env
.env.local
config.local.js

# Don't track the user's local storage exports
exports/
*.export.json
temp/
